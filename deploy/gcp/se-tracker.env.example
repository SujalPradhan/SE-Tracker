# /etc/se-tracker.env — read by the se-tracker and caddy services.

# Public hostname Caddy serves (and gets a Let's Encrypt cert for).
# With no domain, use the static IP via sslip.io, e.g. 34-100-12-34.sslip.io
SITE_ADDRESS=se-tracker.example.com

SECRET_KEY=change-me
HTTPS_ONLY=1
BEHIND_PROXY=1
DATABASE_URL=sqlite:////var/lib/se-tracker/se_tracker.db

# Google OAuth client (Google Auth Platform → Clients → Web application)
# Authorized redirect URI: https://<SITE_ADDRESS>/admin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: override the built-in admin allowlist (comma-separated).
# ADMIN_EMAILS=a@study.iitm.ac.in,b@ds.study.iitm.ac.in

# Nightly SQLite backups go here (bucket must exist; VM needs storage write scope).
BACKUP_BUCKET=
